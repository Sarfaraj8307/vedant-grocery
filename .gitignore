# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-old/
# Build directories moved aside to work around a stale-cache failure. Without
# this pattern `git add -A` stages ~100 MB of stale Turbopack cache.
/.next.stale*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch: DB harness scripts and verification screenshots
/.logs/
/.tmp/

# agent/tool state — project memory and session metadata, not application code.
# Kept out of git so a stray note can never become a committed secret.
# Unanchored on purpose: this matches at any depth, including nested projects.
.workbuddy-ai/

# Kotlin/Gradle build noise
.kotlin/
*.hprof

.vercel

# The admin app lives in its own repository:/n#   https://github.com/Sarfaraj8307/vedant-admin-android
# It stays on disk here for local development, but is not tracked in this repo.
admin-android/
