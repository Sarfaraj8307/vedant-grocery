<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security config (brief §37).

  Cleartext HTTP is never permitted — in any build type. The app talks to
  Supabase over HTTPS only (the publishable key is public by design; it is
  the ROLE of every endpoint that is gated, not the transport, and that
  gating is RLS + private.is_admin() server-side).

  There is deliberately no `debug-overrides` block: the debug build uses the
  very same Supabase origin as release (see `build.gradle.kts` — the URL and
  publishable key come from `local.properties` for every build type, and the
  only debug difference is the `.debug` applicationId suffix). An allow-list
  carve-out here would either permit cleartext that nothing needs, or pretend
  a debug endpoint exists that does not.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
